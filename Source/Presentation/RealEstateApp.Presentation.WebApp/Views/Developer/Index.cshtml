@using RealEstateApp.Core.Application.ViewsModel.Users.Consult
@model List<DeveloperListItemViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mantenimiento de Desarrolladores";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--color-text);">Desarrolladores</h2>
            <p class="text-muted mb-0">Listado general de usuarios con privilegios de desarrollador (Acceso API).</p>
        </div>
        <div>
            <a asp-controller="Developer" asp-action="Create" class="rea-btn rea-btn--primary">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <line x1="19" y1="8" x2="19" y2="14" />
                    <line x1="16" y1="11" x2="22" y2="11" />
                </svg>
                Crear Desarrollador
            </a>
        </div>
    </div>

    <!-- Table Section -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5" style="border-radius: var(--radius-card); background: var(--color-surface);">
            <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 text-muted">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
            </svg>
            <h4 class="fw-bold">No hay desarrolladores registrados</h4>
            <p class="text-muted mb-0">Usa el botón de la parte superior para crear un nuevo usuario desarrollador.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle admin-table">
                <thead>
                    <tr style="color: var(--color-text-secondary); font-size: 0.85rem; font-weight: 700; border-bottom: 2px solid var(--color-border);">
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Nombre de Usuario</th>
                        <th>Cédula</th>
                        <th>Correo Electrónico</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dev in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--color-border);">
                            <td class="fw-semibold">@dev.Name</td>
                            <td>@dev.LastName</td>
                            <td>
                                <span class="badge bg-secondary py-2 px-3 text-dark fw-semibold" style="font-size: 0.8rem; background-color: var(--color-surface-variant) !important; color: var(--color-text) !important; border-radius: 8px;">
                                    @@@dev.UserName
                                </span>
                            </td>
                            <td>@dev.IdCard</td>
                            <td>@dev.Email</td>
                            <td>
                                @if (dev.IsActive)
                                {
                                    <span class="badge py-2 px-3 fw-semibold" style="background: rgba(46, 158, 91, 0.1); color: #2e9e5b; border-radius: 8px; font-size: 0.8rem;">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge py-2 px-3 fw-semibold" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; border-radius: 8px; font-size: 0.8rem;">
                                        Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <!-- Botón toggle de estado -->
                                    <button type="button" 
                                            class="btn fw-semibold d-inline-flex align-items-center justify-content-center py-2 px-3" 
                                            style="border-radius: 10px; font-size: 0.8rem; @(dev.IsActive ? "background: rgba(239, 68, 68, 0.08); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);" : "background: rgba(46, 158, 91, 0.08); color: #2e9e5b; border: 1px solid rgba(46, 158, 91, 0.2);")"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalToggleStatus"
                                            data-user-id="@dev.Id"
                                            data-user-active="@(dev.IsActive ? "true" : "false")"
                                            data-user-name="@(dev.Name + " " + dev.LastName)">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" class="me-1">
                                            @if (dev.IsActive)
                                            {
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                            }
                                            else
                                            {
                                                <path d="M20 6L9 17l-5-5"/>
                                            }
                                        </svg>
                                        @(dev.IsActive ? "Inactivar" : "Activar")
                                    </button>

                                    <!-- Botón Editar -->
                                    <a asp-controller="Developer" 
                                       asp-action="Edit" 
                                       asp-route-id="@dev.Id" 
                                       class="btn fw-semibold d-inline-flex align-items-center justify-content-center py-2 px-3" 
                                       style="background: rgba(79, 124, 130, 0.08); color: var(--color-secondary); border: 1px solid rgba(79, 124, 130, 0.2); border-radius: 10px; font-size: 0.8rem;">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7m-6-5l6-6 3 3L13 16l-4 1 1-4z" />
                                        </svg>
                                        Editar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Toggle Status -->
<div class="modal fade" id="modalToggleStatus" tabindex="-1" aria-labelledby="modalToggleStatusLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-card);">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#f59e0b" stroke-width="2">
                        <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    </svg>
                    <h5 class="modal-title fw-bold mb-0" id="modalToggleStatusLabel" style="color: var(--color-text);">Cambiar Estado</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar" style="filter: invert(1);"></button>
            </div>
            <div class="modal-body pt-3" style="color: var(--color-text-secondary);">
                <p id="toggleStatusBodyText" class="mb-0">¿Está seguro de que desea cambiar el estado de este desarrollador?</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" style="border-radius: 10px;" data-bs-dismiss="modal">Volver</button>
                <form id="formToggleStatus" asp-controller="Developer" asp-action="ToggleStatus" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="toggleStatusId" name="id" value="" />
                    <input type="hidden" id="toggleStatusActive" name="active" value="" />
                    <button type="submit" class="btn btn-primary fw-semibold px-4" style="border-radius: 10px; background-color: var(--color-primary); border-color: var(--color-primary);">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>
