@model RealEstateApp.Core.Application.ViewsModel.Users.Consult.AgentViewModel

<article class="agent-card">
    <div class="agent-card__media">
        @if (!string.IsNullOrWhiteSpace(Model.ProfileImgAgent))
        {
            <img src="~/@Model.ProfileImgAgent" alt="Agente @Model.Name @Model.LastName" loading="lazy" />
        }
        else
        {
            <span class="agent-card__initials" aria-label="Agente @Model.Name @Model.LastName sin foto de perfil">@Model.Name.Substring(0, 1)</span>
        }
    </div>
    <div class="agent-card__body">
        <span class="agent-card__role">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2 15 8l6 .75-4.5 4.38 1.13 6.37L12 16.5l-5.63 3L7.5 13.13 3 8.75 9 8z" />
            </svg>
            <span>Agente inmobiliario</span>
        </span>
        <h3 class="agent-card__name">@Model.Name @Model.LastName</h3>
        <a class="rea-btn rea-btn--primary agent-card__cta" asp-controller="AgentFunctionsPublic" asp-action="PropertyByAgent" asp-route-AgentId="@Model.Id">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5 9.5V21h14V9.5" />
                <path d="M9.5 21v-6h5v6" />
            </svg>
            <span>Ver propiedades</span>
        </a>
    </div>
</article>
