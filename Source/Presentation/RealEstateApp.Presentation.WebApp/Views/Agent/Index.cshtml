@using RealEstateApp.Core.Application.ViewsModel.Property
@using RealEstateApp.Core.Domain.Common.Enums.PropertyStatus
@model List<PropertyCardViewModel>
@{
    ViewData["Title"] = "Panel de Agente";
    var totalCount = Model.Count;
    var availableCount = Model.Count(p => p.Status == PropertyState.Available);
    var soldCount = Model.Count(p => p.Status == PropertyState.Sold);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold mb-0">Mi Dashboard</h2>
        <div>
            <a asp-controller="AgentProperty" asp-action="Index" class="rea-btn rea-btn--secondary me-2">Mantenimiento de Propiedades</a>
            <a asp-controller="AgentProperty" asp-action="Create" class="rea-btn rea-btn--primary">Nueva Propiedad</a>
        </div>
    </div>

    <!-- Metrics Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: var(--color-text-secondary); letter-spacing: 0.1em;">Total Publicadas</h5>
                    <h1 class="fw-bold m-0" style="color: var(--color-text);">@totalCount</h1>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: var(--color-text-secondary); letter-spacing: 0.1em;">Disponibles</h5>
                    <h1 class="fw-bold m-0" style="color: #22c55e;">@availableCount</h1>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: var(--color-text-secondary); letter-spacing: 0.1em;">Vendidas</h5>
                    <h1 class="fw-bold m-0" style="color: #ef4444;">@soldCount</h1>
                </div>
            </div>
        </div>
    </div>

    <!-- Properties List -->
    <h3 class="fw-bold mb-4">Mis Publicaciones</h3>
    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5">
            <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 text-muted">
                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5 9.5V21h14V9.5" />
                <path d="M9.5 21v-6h5v6" />
            </svg>
            <h4 class="fw-bold">No tienes ninguna propiedad registrada</h4>
            <p class="text-muted mb-4">Comienza registrando tu primera propiedad en venta o alquiler.</p>
            <a asp-controller="AgentProperty" asp-action="Create" class="rea-btn rea-btn--primary">Registrar Propiedad</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var property in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: var(--radius-card); overflow: hidden;">
                        <div style="position: relative; height: 180px; overflow: hidden; background-color: var(--color-surface-variant);">
                            @if (!string.IsNullOrEmpty(property.ImageUrl))
                            {
                                <img src="/@property.ImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Imagen de @property.Code" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                    <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                        <circle cx="8.5" cy="8.5" r="1.5" />
                                        <polyline points="21 15 16 10 5 21" />
                                    </svg>
                                </div>
                            }
                            <div style="position: absolute; top: 12px; right: 12px;">
                                @if (property.Status == PropertyState.Available)
                                {
                                    <span class="badge bg-success px-3 py-2 shadow-sm">Disponible</span>
                                }
                                else if (property.Status == PropertyState.Sold)
                                {
                                    <span class="badge bg-danger px-3 py-2 shadow-sm">Vendida</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 shadow-sm">No Disponible</span>
                                }
                            </div>
                            <div style="position: absolute; bottom: 12px; left: 12px; background: rgba(0,0,0,0.6); color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">
                                CÓDIGO: @property.Code
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title fw-bold text-primary mb-2">@string.Format("{0:C}", property.Price)</h4>
                            <p class="card-text text-muted mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @property.Description
                            </p>
                            <hr class="my-2" style="color: var(--color-border);" />
                            <div class="d-flex justify-content-between text-muted" style="font-size: 0.85rem;">
                                <span>
                                    <strong>@property.Bedrooms</strong> habs
                                </span>
                                <span>
                                    <strong>@property.Bathrooms</strong> baños
                                </span>
                                <span>
                                    <strong>@property.Size</strong> m²
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <partial name="_Pagination" />
    }
</div>
