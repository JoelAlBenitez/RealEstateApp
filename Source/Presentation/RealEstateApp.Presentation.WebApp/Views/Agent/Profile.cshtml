@model RealEstateApp.Core.Application.ViewsModel.Users.Operational.ExternalUser.EditExternalUserViewModel
@{
    ViewData["Title"] = "Mi Perfil de Agente";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0" style="border-radius: var(--radius-card);">
                <div class="card-body p-5">
                    <h2 class="fw-bold mb-4 text-center" style="color: var(--color-primary);">Mi Perfil</h2>
                    <p class="text-muted text-center mb-5">Mantén tu información de contacto actualizada para que los clientes puedan comunicarse contigo.</p>

                    <form asp-controller="Agent" asp-action="Profile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ProfileImgCurrent" />

                        <!-- Profile Image Current Display & Upload -->
                        <div class="text-center mb-5">
                            <div class="position-relative d-inline-block mb-3">
                                @if (!string.IsNullOrEmpty(Model.ProfileImgCurrent))
                                {
                                    <img src="/@Model.ProfileImgCurrent" class="rounded-circle shadow-sm" style="width: 150px; height: 150px; object-fit: cover; border: 4px solid var(--color-border);" alt="Foto de perfil actual" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 150px; height: 150px; color: var(--color-primary); border: 4px solid var(--color-border);">
                                        <svg viewBox="0 0 24 24" width="70" height="70" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                            <circle cx="12" cy="7" r="4" />
                                        </svg>
                                    </div>
                                }
                            </div>

                            <div class="mb-3 mx-auto" style="max-width: 320px;">
                                <label for="NewProfileImage" class="form-label fw-bold">Actualizar foto de perfil</label>
                                <input class="form-control" type="file" id="NewProfileImage" name="NewProfileImage" accept="image/*" />
                                <span class="text-muted font-sm">Se sugiere un tamaño cuadrado para mejor visualización.</span>
                                <span class="field-validation-error text-danger" asp-validation-for="NewProfileImage"></span>
                            </div>
                        </div>

                        <!-- Fields Grid -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold" asp-for="Name">Nombre</label>
                                <input class="form-control form-control-lg" asp-for="Name" placeholder="Tu nombre" />
                                <span class="field-validation-error text-danger" asp-validation-for="Name"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold" asp-for="LastName">Apellido</label>
                                <input class="form-control form-control-lg" asp-for="LastName" placeholder="Tu apellido" />
                                <span class="field-validation-error text-danger" asp-validation-for="LastName"></span>
                            </div>
                        </div>

                        <div class="mb-5">
                            <label class="form-label fw-bold" asp-for="PhoneNumber">Número de teléfono</label>
                            <input class="form-control form-control-lg" asp-for="PhoneNumber" placeholder="8095551234" maxlength="10" />
                            <span class="text-muted font-sm">Número dominicano a 10 dígitos sin guiones.</span>
                            <span class="field-validation-error text-danger" asp-validation-for="PhoneNumber"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="rea-btn rea-btn--secondary">Cancelar</a>
                            <button type="submit" class="rea-btn rea-btn--primary">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
