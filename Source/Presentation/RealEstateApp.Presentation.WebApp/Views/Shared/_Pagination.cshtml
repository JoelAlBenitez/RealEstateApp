@model RealEstateApp.Core.Application.ViewsModel.Property.HomePropertiesViewModel
@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;

@if (Model.TotalPages > 1)
    if (totalPages <= 1)
{
    <nav class="pagination" aria-label="Paginación de propiedades">
        @for (var i = 1; i <= Model.TotalPages; i++)
        return;
    }

    var queryParams = new Dictionary<string, string>();
    var httpContext = ViewContext.HttpContext;
    foreach (var q in httpContext.Request.Query)
        {
            if (Model.IsAgentContext)
        if (!string.Equals(q.Key, "pageNumber", StringComparison.OrdinalIgnoreCase))
            {
                <a class="pagination__page@(i == Model.Page ? " pagination__page--active" : "")"
                   asp-controller="AgentFunctionsPublic" asp-action="PropertyByAgent"
                   asp-route-AgentId="@Model.AgentId" asp-route-page="@i">@i</a>
            queryParams[q.Key] = q.Value.ToString();
            }
            else if (Model.IsFiltered)
    }

    string BuildUrl(int page)
            {
                <a class="pagination__page@(i == Model.Page ? " pagination__page--active" : "")"
                   asp-controller="Home" asp-action="Index"
                   asp-route-MinPrice="@Model.Filter.MinPrice"
                   asp-route-MaxPrice="@Model.Filter.MaxPrice"
                   asp-route-Bedrooms="@Model.Filter.Bedrooms"
                   asp-route-Bathrooms="@Model.Filter.Bathrooms"
                   asp-route-IdTypeProperty="@Model.Filter.IdTypeProperty"
                   asp-route-page="@i">@i</a>
        var parts = new List<string>();
        foreach (var kv in queryParams)
        {
            parts.Add($"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}");
            }
            else
        parts.Add($"pageNumber={page}");
        return $"?{string.Join("&", parts)}";
    }

    int maxVisible = 5;
    int half = maxVisible / 2;
    int startPage = Math.Max(1, currentPage - half);
    int endPage = Math.Min(totalPages, startPage + maxVisible - 1);
    if (endPage - startPage + 1 < maxVisible)
            {
                <a class="pagination__page@(i == Model.Page ? " pagination__page--active" : "")"
                   asp-controller="Home" asp-action="Index" asp-route-page="@i">@i</a>
        startPage = Math.Max(1, endPage - maxVisible + 1);
    }
}

<style>
    .rea-pagination {
        display: inline-flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
    }
    .rea-pagination a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 38px;
        height: 38px;
        padding: 0 12px;
        border-radius: 50px;
        background: var(--color-surface-variant);
        color: var(--color-text);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
        transition: background 0.2s, color 0.2s;
        border: 1px solid var(--color-border);
    }
    .rea-pagination a:hover {
        background: var(--color-primary);
        color: #fff;
        border-color: var(--color-primary);
    }
    .rea-pagination a.active {
        background: var(--color-primary);
        color: #fff;
        border-color: var(--color-primary);
        pointer-events: none;
    }
    .rea-pagination a.disabled {
        opacity: 0.4;
        pointer-events: none;
            }
</style>

<div class="d-flex justify-content-center mt-4 mb-2">
    <nav class="rea-pagination">
        <a href="@BuildUrl(1)" class="@(currentPage == 1 ? "disabled" : "")">&#171; Primera</a>
        <a href="@BuildUrl(Math.Max(1, currentPage - 1))" class="@(currentPage == 1 ? "disabled" : "")">&#8249; Ant</a>

        @for (int i = startPage; i <= endPage; i++)
        {
            <a href="@BuildUrl(i)" class="@(i == currentPage ? "active" : "")">@i</a>
        }

        <a href="@BuildUrl(Math.Min(totalPages, currentPage + 1))" class="@(currentPage == totalPages ? "disabled" : "")">Sig &#8250;</a>
        <a href="@BuildUrl(totalPages)" class="@(currentPage == totalPages ? "disabled" : "")">Última &#187;</a>
    </nav>
}
</div>
