<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Real Estate App</title>

    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet" href="~/css/layout/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications/notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account/account.css" asp-append-version="true" />

    <script src="~/js/layout/theme-init.js" asp-append-version="true"></script>
</head>
<body class="account-body">
    <partial name="_Notifications" />

    <button class="account-theme-toggle" id="accountThemeToggle" type="button" aria-label="Cambiar tema claro u oscuro">
        <svg class="account-theme-toggle__icon account-theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="account-theme-toggle__icon account-theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
    </button>

    @RenderBody()

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/notifications/notifications.js" asp-append-version="true"></script>
    <script src="~/js/account/account.js" asp-append-version="true"></script>
</body>
</html>
