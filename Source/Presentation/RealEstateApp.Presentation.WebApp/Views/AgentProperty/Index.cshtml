@using RealEstateApp.Core.Application.ViewsModel.Property
@model List<PropertyCardViewModel>
@{
    ViewData["Title"] = "Mantenimiento de Propiedades";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold mb-0" style="color: var(--color-text);">Mis Propiedades Disponibles</h2>
        <a asp-action="Create" class="rea-btn rea-btn--primary">Registrar Nueva Propiedad</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5">
            <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 text-muted">
                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5 9.5V21h14V9.5" />
                <path d="M9.5 21v-6h5v6" />
            </svg>
            <h4 class="fw-bold">No tienes propiedades disponibles registradas</h4>
            <p class="text-muted mb-4">Comienza registrando una propiedad para que los clientes puedan verla y realizar ofertas.</p>
            <a asp-action="Create" class="rea-btn rea-btn--primary">Registrar Propiedad</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var property in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: var(--radius-card); background: var(--color-surface); overflow: hidden; display: flex; flex-direction: column;">
                        <div class="position-relative" style="height: 180px; overflow: hidden; background: var(--color-surface-variant);">
                            <a asp-action="Details" asp-route-id="@property.Id" class="d-block w-100 h-100">
                                @if (!string.IsNullOrEmpty(property.ImageUrl))
                                {
                                    <img src="/@property.ImageUrl" class="w-100 h-100" style="object-fit: cover; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" alt="Propiedad @property.Code" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="color: var(--color-text-secondary);">
                                        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                            <polyline points="21 15 16 10 5 21" />
                                        </svg>
                                    </div>
                                }
                            </a>
                            <span class="position-absolute badge bg-dark px-3 py-2" style="top: 12px; left: 12px; font-size: 0.8rem; font-weight: 700; border-radius: 6px; letter-spacing: 0.05em; opacity: 0.85; pointer-events: none;">
                                #@property.Code
                            </span>
                        </div>

                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <div class="mb-3">
                                <small class="d-block mb-1" style="color: var(--color-text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Precio de Publicación</small>
                                <h3 class="fw-bold mb-0" style="color: #22c55e;">@string.Format("{0:C}", property.Price)</h3>
                            </div>

                            <div class="d-flex align-items-center justify-content-between py-3 mb-4" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); font-size: 0.88rem; color: var(--color-text);">
                                <div class="d-flex align-items-center gap-1">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-text-secondary);">
                                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                        <polyline points="9 22 9 12 15 12 15 22" />
                                    </svg>
                                    <span>@property.Bedrooms Hab</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-text-secondary);">
                                        <path d="M4 19h16M4 15h16M4 11h16M8 3v4M16 3v4" />
                                    </svg>
                                    <span>@property.Bathrooms Baños</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--color-text-secondary);">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                                    </svg>
                                    <span>@property.Size m²</span>
                                </div>
                            </div>

                            <div class="mt-auto d-flex flex-wrap gap-2">
                                <a asp-controller="AgentOffers" asp-action="Index" asp-route-propertyId="@property.Id" 
                                   class="btn flex-fill fw-semibold d-inline-flex align-items-center justify-content-center py-2" 
                                   style="background: rgba(34,197,94,0.1); color: #22c55e; border: 1px solid rgba(34,197,94,0.3); border-radius: 8px; font-size: 0.85rem;">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                    </svg>
                                    Ofertas
                                </a>
                                <a asp-action="Edit" asp-route-id="@property.Id" 
                                   class="btn flex-fill fw-semibold d-inline-flex align-items-center justify-content-center py-2" 
                                   style="background: rgba(13,110,253,0.1); color: var(--color-primary); border: 1px solid rgba(13,110,253,0.3); border-radius: 8px; font-size: 0.85rem;">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z" />
                                    </svg>
                                    Editar
                                </a>
                                <a asp-action="Delete" asp-route-id="@property.Id" 
                                   class="btn flex-fill fw-semibold d-inline-flex align-items-center justify-content-center py-2" 
                                   style="background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; font-size: 0.85rem;">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <path d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16" />
                                    </svg>
                                    Eliminar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <partial name="_Pagination" />
    }
</div>
