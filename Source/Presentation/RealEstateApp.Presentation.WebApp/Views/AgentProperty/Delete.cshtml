@using RealEstateApp.Core.Application.ViewsModel.Property
@model PropertyCardViewModel
@{
    ViewData["Title"] = $"Eliminar Propiedad {Model.Code}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm border-0" style="border-radius: var(--radius-card);">
                <div class="card-body p-5 text-center">
                    <span class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle p-4 mb-4" style="width: 80px; height: 80px;">
                        <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                            <line x1="10" y1="11" x2="10" y2="17" />
                            <line x1="14" y1="11" x2="14" y2="17" />
                        </svg>
                    </span>

                    <h2 class="fw-bold mb-3">¿Desea eliminar esta propiedad?</h2>
                    <p class="text-muted mb-4">Está a punto de eliminar permanentemente la propiedad con código <strong class="text-dark">@Model.Code</strong>.</p>

                    <!-- Property card recap -->
                    <div class="card border mb-5" style="border-radius: 8px; overflow: hidden;">
                        <div class="row g-0 align-items-center">
                            <div class="col-4" style="height: 90px; background-color: var(--color-surface-variant);">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="/@Model.ImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Miniatura de @Model.Code" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                        </svg>
                                    </div>
                                }
                            </div>
                            <div class="col-8 text-start ps-3">
                                <h5 class="fw-bold text-primary mb-1">@string.Format("{0:C}", Model.Price)</h5>
                                <p class="text-muted font-sm mb-0">Tamaño: @Model.Size m² | Habs: @Model.Bedrooms</p>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-danger border-0 d-flex align-items-start mb-5" role="alert">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" class="me-2 mt-1 flex-shrink-0">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                        <div class="text-start" style="font-size: 0.88rem;">
                            <strong>¡Atención!</strong> Esta acción es irreversible. Se eliminarán todos los archivos físicos de fotos en el servidor y las ofertas registradas asociadas a esta propiedad.
                        </div>
                    </div>

                    <!-- Delete Form -->
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="rea-btn rea-btn--secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger btn-lg px-4" style="border-radius: var(--radius-button); font-weight: 600;">Sí, Eliminar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
