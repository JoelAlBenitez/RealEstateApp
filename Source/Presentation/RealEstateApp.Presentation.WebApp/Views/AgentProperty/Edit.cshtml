@using RealEstateApp.Core.Application.ViewsModel.Property
@model SavePropertyViewModel
@{
    ViewData["Title"] = "Editar Propiedad";
}

<div class="container-fluid py-4 px-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <div class="card shadow-sm border-0" style="border-radius: var(--radius-card);">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4">
                        <a asp-action="Index" class="text-decoration-none d-inline-flex align-items-center" style="color: var(--color-primary); font-weight: 600;">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                                <path d="M19 12H5M12 19l-7-7 7-7"/>
                            </svg>
                            Volver al listado
                        </a>
                    </div>

                    <h2 class="fw-bold mb-1" style="color: var(--color-primary);">Editar Propiedad: @Model.Code</h2>
                    <p class="text-muted mb-4">Modifica los campos necesarios para actualizar la publicación.</p>

                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Code" />
                        <input type="hidden" asp-for="Status" />

                        <!-- Row 1: Tipo Propiedad, Tipo Venta, Precio -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label class="form-label fw-bold" asp-for="PropertyTypeId">Tipo de Propiedad</label>
                                <select class="form-select" asp-for="PropertyTypeId">
                                    <option value="">Seleccione un tipo...</option>
                                    <option value="1">Casa</option>
                                    <option value="2">Apartamento</option>
                                    <option value="3">Villa</option>
                                    <option value="4">Solar</option>
                                </select>
                                <span class="field-validation-error text-danger" asp-validation-for="PropertyTypeId"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold" asp-for="SaleTypeId">Tipo de Venta</label>
                                <select class="form-select" asp-for="SaleTypeId">
                                    <option value="">Seleccione un tipo...</option>
                                    <option value="1">Venta</option>
                                    <option value="2">Alquiler</option>
                                </select>
                                <span class="field-validation-error text-danger" asp-validation-for="SaleTypeId"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold" asp-for="Price">Precio</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" asp-for="Price" step="0.01" min="0.01" placeholder="Monto" />
                                </div>
                                <span class="field-validation-error text-danger" asp-validation-for="Price"></span>
                            </div>
                        </div>

                        <!-- Row 2: Tamaño, Habitaciones, Baños -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label class="form-label fw-bold" asp-for="Size">Tamaño (m²)</label>
                                <input type="number" class="form-control" asp-for="Size" step="0.01" min="1" placeholder="Metraje" />
                                <span class="field-validation-error text-danger" asp-validation-for="Size"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold" asp-for="Bedrooms">Habitaciones</label>
                                <input type="number" class="form-control" asp-for="Bedrooms" min="0" placeholder="Ej: 3" />
                                <span class="field-validation-error text-danger" asp-validation-for="Bedrooms"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold" asp-for="Bathrooms">Baños</label>
                                <input type="number" class="form-control" asp-for="Bathrooms" min="0" placeholder="Ej: 2" />
                                <span class="field-validation-error text-danger" asp-validation-for="Bathrooms"></span>
                            </div>
                        </div>

                        <!-- Row 3: Description & Image Upload Side-by-Side -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-8">
                                <label class="form-label fw-bold" asp-for="Description">Descripción</label>
                                <textarea class="form-control" asp-for="Description" rows="4" placeholder="Describe la propiedad..." maxlength="1000"></textarea>
                                <span class="field-validation-error text-danger" asp-validation-for="Description"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold" asp-for="ImageFiles">Agregar Nuevas Imágenes</label>
                                <input class="form-control" type="file" asp-for="ImageFiles" id="imageFilesInput" accept="image/*" multiple />
                                <span class="text-muted font-sm d-block mt-1">El total de fotos asociadas no puede exceder las 4 unidades (puedes seleccionar varias).</span>
                                <span class="field-validation-error text-danger" asp-validation-for="ImageFiles"></span>
                                <div id="imagePreviewGrid" class="row g-2 mt-2"></div>
                            </div>
                        </div>

                        <!-- Improvements Selection -->
                        <div class="mb-4 border-top pt-3">
                            <label class="form-label fw-bold mb-2 d-block">Mejoras de la Propiedad</label>
                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-2">
                                <div class="col">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="ImprovementIds" id="imp1" value="1" @(Model.ImprovementIds != null && Model.ImprovementIds.Contains(1) ? "checked" : "") />
                                        <label class="form-check-label" for="imp1">Piscina</label>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="ImprovementIds" id="imp2" value="2" @(Model.ImprovementIds != null && Model.ImprovementIds.Contains(2) ? "checked" : "") />
                                        <label class="form-check-label" for="imp2">Gimnasio</label>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="ImprovementIds" id="imp3" value="3" @(Model.ImprovementIds != null && Model.ImprovementIds.Contains(3) ? "checked" : "") />
                                        <label class="form-check-label" for="imp3">Parqueo</label>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="ImprovementIds" id="imp4" value="4" @(Model.ImprovementIds != null && Model.ImprovementIds.Contains(4) ? "checked" : "") />
                                        <label class="form-check-label" for="imp4">Jardín</label>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="ImprovementIds" id="imp5" value="5" @(Model.ImprovementIds != null && Model.ImprovementIds.Contains(5) ? "checked" : "") />
                                        <label class="form-check-label" for="imp5">Terraza</label>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="ImprovementIds" id="imp6" value="6" @(Model.ImprovementIds != null && Model.ImprovementIds.Contains(6) ? "checked" : "") />
                                        <label class="form-check-label" for="imp6">Seguridad 24/7</label>
                                    </div>
                                </div>
                            </div>
                            <span class="field-validation-error text-danger" asp-validation-for="ImprovementIds"></span>
                        </div>

                        <!-- Existing Images Display -->
                        <div class="mb-4 border-top pt-3">
                            <label class="form-label fw-bold mb-2 d-block">Imágenes actuales (Desmarca para eliminar físicamente)</label>
                            @if (Model.ExistingImageUrls != null && Model.ExistingImageUrls.Any())
                            {
                                <div class="row g-2">
                                    @foreach (var imgUrl in Model.ExistingImageUrls)
                                    {
                                        <div class="col-6 col-md-3">
                                            <div class="card h-100 border shadow-sm" style="overflow: hidden;">
                                                <img src="/@imgUrl" class="w-100" style="height: 100px; object-fit: cover;" alt="Imagen propiedad" />
                                                <div class="card-body p-2 text-center bg-light">
                                                    <div class="form-check form-check-inline m-0">
                                                        <input class="form-check-input" type="checkbox" name="ExistingImageUrls" id="img_@imgUrl" value="@imgUrl" checked />
                                                        <label class="form-check-label font-sm text-dark fw-semibold" for="img_@imgUrl">Mantener</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No posee fotos registradas.</p>
                            }
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-content-between align-items-center border-top pt-4">
                            <a asp-action="Index" class="rea-btn rea-btn--secondary">Cancelar</a>
                            <button type="submit" class="rea-btn rea-btn--primary">Actualizar Propiedad</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let selectedFiles = [];

        function showToast(message, type = 'warning') {
            let container = document.querySelector('.rea-toasts');
            if (!container) {
                container = document.createElement('div');
                container.className = 'rea-toasts';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = `rea-toast rea-toast--${type}`;
            toast.setAttribute('role', 'status');

            toast.innerHTML = `
                <span class="rea-toast__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12" y2="17" />
                    </svg>
                </span>
                <div class="rea-toast__content">
                    <strong class="rea-toast__title">${type === 'success' ? 'Éxito' : 'Alerta'}</strong>
                    <p class="rea-toast__text">${message}</p>
                </div>
                <button class="rea-toast__close" type="button" aria-label="Cerrar notificación">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            `;

            container.appendChild(toast);

            const closeBtn = toast.querySelector('.rea-toast__close');
            closeBtn.addEventListener('click', () => {
                toast.classList.add('is-leaving');
                setTimeout(() => toast.remove(), 240);
            });

            setTimeout(() => {
                if (toast.parentNode) {
                    toast.classList.add('is-leaving');
                    setTimeout(() => toast.remove(), 240);
                }
            }, 6000);
        }

        function getPreExistingCount() {
            return document.querySelectorAll('input[name="ExistingImageUrls"]:checked').length;
        }

        document.getElementById('imageFilesInput').addEventListener('change', function (e) {
            const files = e.target.files;
            if (!files.length) return;

            const preExistingCount = getPreExistingCount();

            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                if (!file.type.startsWith('image/')) continue;

                if (selectedFiles.length + preExistingCount >= 4) {
                    showToast('Solo se permite un total de 4 imágenes por propiedad.');
                    break;
                }

                const isDuplicate = selectedFiles.some(f => f.name === file.name && f.size === file.size);
                if (!isDuplicate) {
                    selectedFiles.push(file);
                }
            }

            e.target.value = '';

            renderPreviews();
            updateInputFiles();
        });

        function renderPreviews() {
            const container = document.getElementById('imagePreviewGrid');
            container.innerHTML = '';

            selectedFiles.forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const col = document.createElement('div');
                    col.className = 'col-3 position-relative';
                    col.innerHTML = `
                        <div class="position-relative border rounded overflow-hidden shadow-sm" style="height: 60px; background: var(--color-surface);">
                            <img src="${event.target.result}" class="w-100 h-100" style="object-fit: cover;" alt="Preview" />
                            <button type="button" class="btn btn-danger btn-xs position-absolute top-0 end-0 m-1 px-1 py-0" style="font-size: 10px; line-height: 1; border-radius: 50%; padding: 0px 4px; opacity: 0.85; border: none; color: white;" onclick="removeNewFile(${index})">
                                &times;
                            </button>
                        </div>
                    `;
                    container.appendChild(col);
                };
                reader.readAsDataURL(file);
            });
        }

        window.removeNewFile = function(index) {
            selectedFiles.splice(index, 1);
            renderPreviews();
            updateInputFiles();
        };

        function updateInputFiles() {
            const dataTransfer = new DataTransfer();
            selectedFiles.forEach(file => dataTransfer.items.add(file));
            document.getElementById('imageFilesInput').files = dataTransfer.files;
        }

        // Escuchar cambios en los checks de imágenes existentes para asegurar que no se supere el límite de 4 en total
        document.querySelectorAll('input[name="ExistingImageUrls"]').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                const preExistingCount = getPreExistingCount();
                
                // Si la suma supera 4, alertar y deseleccionar las últimas fotos agregadas para ajustar al límite
                while (selectedFiles.length + preExistingCount > 4) {
                    selectedFiles.pop();
                }
                
                renderPreviews();
                updateInputFiles();
            });
        });
    </script>
}
