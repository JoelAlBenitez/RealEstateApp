@using RealEstateApp.Core.Application.ViewsModel.FavoriteProperty
@model List<FavoritePropertyViewModel>
@{
    ViewData["Title"] = "Mis Propiedades Favoritas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold mb-0" style="color: var(--color-text);">Mis Favoritos</h2>
        <span class="badge bg-primary">@Model.Count propiedades</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5">
            <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 text-muted">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
            </svg>
            <h4 class="fw-bold">Aún no tienes propiedades favoritas</h4>
            <p class="text-muted mb-4">Explora nuestras propiedades disponibles y agrégalas a tu lista para tener acceso rápido a ellas.</p>
            <a asp-controller="Customer" asp-action="Index" class="rea-btn rea-btn--primary">Explorar Propiedades</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var favorite in Model)
            {
                var property = favorite.Property;
                if (property == null) continue;

                <div class="col">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: var(--radius-card); overflow: hidden;">
                        <div style="position: relative; height: 200px; overflow: hidden; background-color: var(--color-surface-variant);">
                            @if (!string.IsNullOrEmpty(property.ImageUrl))
                            {
                                <img src="/@property.ImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Imagen de la propiedad @property.Code" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                    <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                        <circle cx="8.5" cy="8.5" r="1.5" />
                                        <polyline points="21 15 16 10 5 21" />
                                    </svg>
                                </div>
                            }
                            <div style="position: absolute; top: 12px; right: 12px;">
                                <button type="button"
                                        class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                                        style="width: 38px; height: 38px;"
                                        title="Eliminar de favoritos"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalRemoveFavorite"
                                        data-property-id="@property.Id">
                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="#E85D4F" stroke="#E85D4F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                                    </svg>
                                </button>
                            </div>
                            <div style="position: absolute; bottom: 12px; left: 12px; background: rgba(0,0,0,0.6); color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">
                                CÓDIGO: @property.Code
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title fw-bold text-primary mb-2">@string.Format("{0:C}", property.Price)</h4>
                            <p class="card-text text-muted mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @property.Description
                            </p>
                            <hr class="my-2" style="color: var(--color-border);" />
                            <div class="d-flex justify-content-between text-muted mb-3" style="font-size: 0.9rem;">
                                <span>
                                    <strong>@property.Bedrooms</strong> habs
                                </span>
                                <span>
                                    <strong>@property.Bathrooms</strong> baños
                                </span>
                                <span>
                                    <strong>@property.Size</strong> m²
                                </span>
                            </div>
                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@property.Id" class="rea-btn rea-btn--primary w-100 text-center">Ver Detalles</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Eliminar Favorito -->
<div class="modal fade" id="modalRemoveFavorite" tabindex="-1" aria-labelledby="modalRemoveFavoriteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-card);">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="#E85D4F" stroke="#E85D4F" stroke-width="2">
                        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                    </svg>
                    <h5 class="modal-title fw-bold mb-0" id="modalRemoveFavoriteLabel" style="color: var(--color-text);">Eliminar de Favoritos</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar" style="filter: invert(1);"></button>
            </div>
            <div class="modal-body pt-3" style="color: var(--color-text-secondary);">
                <p class="mb-0">¿Desea eliminar esta propiedad de su lista de favoritos?</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formRemoveFavorite" asp-controller="Favorite" asp-action="Remove" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="removeFavPropertyId" name="propertyId" value="" />
                    <button type="submit" class="btn btn-danger fw-semibold px-4">Sí, Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('modalRemoveFavorite').addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('removeFavPropertyId').value = btn.getAttribute('data-property-id');
    });
</script>
}
