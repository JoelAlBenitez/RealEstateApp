@using RealEstateApp.Core.Application.ViewsModel.Property
@model RealEstateApp.Core.Application.ViewsModel.Property.CustomerPropertiesViewModel
@{
    ViewData["Title"] = $"Propiedades del Agente {ViewBag.AgentName}";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Agents" class="text-decoration-none d-inline-flex align-items-center" style="color: var(--color-primary); font-weight: 600;">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Volver a agentes
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--color-text);">Propiedades Publicadas</h2>
            <p class="mb-0" style="color: var(--color-text-secondary);">Agente: <strong style="color: var(--color-text);">@ViewBag.AgentName</strong></p>
        </div>
        <span class="badge bg-primary px-3 py-2">@Model.TotalItems propiedades</span>
    </div>

    @if (!Model.Properties.Any())
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5" style="border-radius: var(--radius-card);">
            <h4 class="fw-bold">Sin propiedades disponibles</h4>
            <p class="text-muted m-0">Este agente no tiene propiedades publicadas o disponibles en este momento.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var property in Model.Properties)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: var(--radius-card); overflow: hidden; background: var(--color-surface);">
                        <div style="position: relative; height: 220px; overflow: hidden; background-color: var(--color-surface-variant);">
                            @if (!string.IsNullOrEmpty(property.ImageUrl))
                            {
                                <img src="/@property.ImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Imagen de la propiedad @property.Code" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                    <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                                        <circle cx="8.5" cy="8.5" r="1.5" />
                                        <polyline points="21 15 16 10 5 21" />
                                    </svg>
                                </div>
                            }
                            <div style="position: absolute; top: 12px; right: 12px;">
                                <form asp-controller="Favorite" asp-action="@(property.IsFavorite ? "Remove" : "Add")" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="propertyId" value="@property.Id" />
                                    <button type="submit" class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" title="@(property.IsFavorite ? "Eliminar de favoritos" : "Agregar a favoritos")">
                                        <svg viewBox="0 0 24 24" width="20" height="20" fill="@(property.IsFavorite ? "#E85D4F" : "none")" stroke="@(property.IsFavorite ? "#E85D4F" : "currentColor")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                            <div style="position: absolute; bottom: 12px; left: 12px; background: rgba(0,0,0,0.6); color: #fff; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">
                                CÓDIGO: @property.Code
                            </div>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title fw-bold text-primary mb-2">@string.Format("{0:C}", property.Price)</h4>
                            <p class="card-text text-muted mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @property.Description
                            </p>
                            <hr class="my-2" style="color: var(--color-border);" />
                            <div class="d-flex justify-content-between text-muted mb-3" style="font-size: 0.85rem;">
                                <span><strong>@property.Bedrooms</strong> habs</span>
                                <span><strong>@property.Bathrooms</strong> baños</span>
                                <span><strong>@property.Size</strong> m²</span>
                            </div>
                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@property.Id" class="rea-btn rea-btn--primary w-100 justify-content-center">Ver Detalles</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <partial name="_Pagination" />
    }
</div>
