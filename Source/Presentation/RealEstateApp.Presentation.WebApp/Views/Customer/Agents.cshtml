@model RealEstateApp.Core.Application.ViewsModel.Users.Consult.AgentsHomeViewModel
@{
    ViewData["Title"] = "Agentes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/agents/agents.css" asp-append-version="true" />
}

<div class="container py-4">
    <section class="agents-hero mb-4 py-4 px-3 rounded text-center" style="background: var(--color-surface-variant); border: 1px solid var(--color-border); border-radius: var(--radius-card);">
        <span class="badge bg-primary px-3 py-2 mb-2">Equipo verificado</span>
        <h2 class="fw-bold mb-1" style="color: var(--color-text);">Nuestros Agentes Inmobiliarios</h2>
        <p class="text-muted mb-0">
            Profesionales listos para mostrarte propiedades y ayudarte a tomar la mejor decisión.
        </p>
    </section>

    <section class="agents">
        <div class="row g-4">
            <div class="col-lg-8">
                @if (Model.Agents.Count == 0)
                {
                    var emptyMessage = Model.IsConsult
                        ? "No se encontraron agentes activos con el nombre ingresado."
                        : "No hay agentes activos disponibles en este momento. Vuelve a intentarlo más tarde.";
                    <div class="alert alert-info text-center py-5 border-0 shadow-sm" style="border-radius: var(--radius-card);">
                        <h4 class="fw-bold">Sin resultados</h4>
                        <p class="text-muted m-0">@emptyMessage</p>
                    </div>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-4" id="agentGrid">
                        @foreach (var agent in Model.Agents)
                        {
                            <div class="col">
                                <partial name="~/Views/AgentFunctionsPublic/_AgentCard.cshtml" model="agent" />
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="col-lg-4">
                <div class="card shadow-sm border-0" style="border-radius: var(--radius-card); background: var(--color-surface);">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--color-text);">Buscar Agente</h5>
                        <form asp-controller="Customer" asp-action="AgentsConsult" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="agentSearchName" class="form-label fw-semibold" style="color: var(--color-text);">Nombre o Apellido</label>
                                <input type="text" class="form-control" id="agentSearchName" name="Name" value="@Model.Consult.Name" placeholder="Escribe para buscar..." required />
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="rea-btn rea-btn--primary flex-fill justify-content-center">Buscar</button>
                                @if (Model.IsConsult)
                                {
                                    <a asp-action="Agents" class="rea-btn rea-btn--secondary flex-fill text-center justify-content-center">Limpiar</a>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
