@using RealEstateApp.Core.Application.ViewsModel.Users.Operational.InternaUser
@model EditInternalUserViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Administrador";
}

<div class="container-fluid py-4 px-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card shadow-sm border-0" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4">
                        <a asp-action="Index" class="text-decoration-none d-inline-flex align-items-center" style="color: var(--color-primary); font-weight: 600;">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                                <path d="M19 12H5M12 19l-7-7 7-7"/>
                            </svg>
                            Volver al listado
                        </a>
                    </div>

                    <h2 class="fw-bold mb-1" style="color: var(--color-primary);">Editar Administrador</h2>
                    <p class="text-muted mb-4">Actualiza los datos personales y de cuenta del administrador. Deja en blanco los campos de contraseña si no deseas cambiarla.</p>

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="Id" />

                       

                        <!-- Row 1: Nombre & Apellido -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold" asp-for="Name">Nombre</label>
                                <input type="text" class="form-control" style="border-radius: var(--radius-input); padding: 12px 16px;" asp-for="Name" placeholder="Escriba el nombre" />
                                <span class="field-validation-error text-danger font-sm" asp-validation-for="Name"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold" asp-for="LastName">Apellido</label>
                                <input type="text" class="form-control" style="border-radius: var(--radius-input); padding: 12px 16px;" asp-for="LastName" placeholder="Escriba el apellido" />
                                <span class="field-validation-error text-danger font-sm" asp-validation-for="LastName"></span>
                            </div>
                        </div>

                        <!-- Row 2: Correo & Cédula -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold" asp-for="Email">Correo Electrónico</label>
                                <input type="email" class="form-control" style="border-radius: var(--radius-input); padding: 12px 16px;" asp-for="Email" placeholder="ejemplo@correo.com" />
                                <span class="field-validation-error text-danger font-sm" asp-validation-for="Email"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold" asp-for="IdCard">Cédula</label>
                                <input type="text" class="form-control" style="border-radius: var(--radius-input); padding: 12px 16px;" asp-for="IdCard" placeholder="Ej: 00112345678" maxlength="11" />
                                <span class="field-validation-error text-danger font-sm" asp-validation-for="IdCard"></span>
                            </div>
                        </div>

                        <!-- Row 3: Nombre de Usuario -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-12">
                                <label class="form-label fw-bold" asp-for="UserName">Nombre de Usuario</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="border-top-left-radius: var(--radius-input); border-bottom-left-radius: var(--radius-input);">@@</span>
                                    <input type="text" class="form-control" style="border-top-right-radius: var(--radius-input); border-bottom-right-radius: var(--radius-input); padding: 12px 16px;" asp-for="UserName" placeholder="Nombre de usuario" />
                                </div>
                                <span class="field-validation-error text-danger font-sm" asp-validation-for="UserName"></span>
                            </div>
                        </div>

                        <!-- Row 4: Contraseñas Opcionales -->
                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold" asp-for="NewPassword">Nueva Contraseña (Opcional)</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" style="border-top-left-radius: var(--radius-input); border-bottom-left-radius: var(--radius-input); padding: 12px 16px;" asp-for="NewPassword" placeholder="Dejar vacío si no desea cambiarla" />
                                    <button class="btn btn-outline-secondary" type="button" data-password-toggle="NewPassword" aria-label="Mostrar contraseña" aria-pressed="false" style="border-top-right-radius: var(--radius-input); border-bottom-right-radius: var(--radius-input);">
                                        <svg class="pw-eye pw-eye--show" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                        <svg class="pw-eye pw-eye--hide" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
                                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                            <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                            <line x1="1" y1="1" x2="23" y2="23" />
                                        </svg>
                                    </button>
                                </div>
                                <span class="field-validation-error text-danger font-sm" asp-validation-for="NewPassword"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold" asp-for="ConfirmNewPassword">Confirmar Nueva Contraseña (Opcional)</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" style="border-top-left-radius: var(--radius-input); border-bottom-left-radius: var(--radius-input); padding: 12px 16px;" asp-for="ConfirmNewPassword" placeholder="Dejar vacío si no desea cambiarla" />
                                    <button class="btn btn-outline-secondary" type="button" data-password-toggle="ConfirmNewPassword" aria-label="Mostrar contraseña" aria-pressed="false" style="border-top-right-radius: var(--radius-input); border-bottom-right-radius: var(--radius-input);">
                                        <svg class="pw-eye pw-eye--show" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                        <svg class="pw-eye pw-eye--hide" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
                                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                            <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                            <line x1="1" y1="1" x2="23" y2="23" />
                                        </svg>
                                    </button>
                                </div>
                                <span class="field-validation-error text-danger font-sm" asp-validation-for="ConfirmNewPassword"></span>
                            </div>
                        </div>
                        <!-- Bottom Actions -->
                        <div class="d-flex justify-content-between align-items-center border-top pt-4 mt-5">
                            <a asp-action="Index" class="rea-btn rea-btn--secondary">Cancelar</a>
                            <button type="submit" class="rea-btn rea-btn--primary">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Admin/password-toggle.js" asp-append-version="true"></script>

}
