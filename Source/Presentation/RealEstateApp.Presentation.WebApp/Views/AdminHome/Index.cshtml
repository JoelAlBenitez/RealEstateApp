@using RealEstateApp.Core.Application.ViewsModel.Users.Consult
@model DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard Administrador";
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5 border-bottom pb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--color-text);">Panel Consolidado</h2>
            <p class="text-muted mb-0">Visualiza estadísticas y el estado de los usuarios y propiedades en tiempo real.</p>
        </div>
        <div>
            <a asp-controller="AdminHome" 
               asp-action="Index" 
               asp-route-showActive="@(!Model.ShowActive)" 
               class="rea-btn rea-btn--secondary">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v8M8 12h8"/>
                </svg>
                @(Model.ShowActive ? "Ver Inactivos" : "Ver Activos")
            </a>
        </div>
    </div>

    <!-- Status Banner indicating what metrics are shown -->
    <div class="alert mb-4 border-0 shadow-sm d-flex align-items-center gap-3 p-3" 
         style="background: rgba(79, 124, 130, 0.1); border-left: 5px solid var(--color-secondary) !important; border-radius: 12px; color: var(--color-text);">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="var(--color-secondary)" stroke-width="2" class="flex-shrink-0">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="16" x2="12" y2="12" />
            <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
        <div>
            <span class="fw-semibold">Filtro de visualización actual:</span> 
            Mostrando estadísticas de usuarios <strong>@(Model.ShowActive ? "Activos" : "Inactivos")</strong> en el sistema.
        </div>
    </div>

    <!-- Metrics Cards Grid -->
    <h3 class="fw-bold mb-4" style="color: var(--color-text); font-size: 1.25rem;">Indicadores Generales</h3>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
        <!-- Available Properties -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 admin-dashboard__card" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: var(--color-text-secondary); letter-spacing: 0.1em;">Propiedades Disponibles</h5>
                    <h1 class="fw-bold m-0" style="color: var(--color-secondary); font-size: 3rem;">@Model.AvailableProperties</h1>
                    <small class="text-muted d-block mt-2">Disponibles para venta/alquiler</small>
                </div>
            </div>
        </div>

        <!-- Sold Properties -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 admin-dashboard__card" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: var(--color-text-secondary); letter-spacing: 0.1em;">Propiedades Vendidas</h5>
                    <h1 class="fw-bold m-0" style="color: var(--color-success); font-size: 3rem;">@Model.SoldProperties</h1>
                    <small class="text-muted d-block mt-2">Transacciones finalizadas</small>
                </div>
            </div>
        </div>

        <!-- Agents (Dynamic based on ShowActive) -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 admin-dashboard__card" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: var(--color-text-secondary); letter-spacing: 0.1em;">
                        @(Model.ShowActive ? "Agentes Activos" : "Agentes Inactivos")
                    </h5>
                    <h1 class="fw-bold m-0" style="color: var(--color-primary); font-size: 3rem;">
                        @(Model.ShowActive ? Model.ActiveAgents : Model.InactiveAgents)
                    </h1>
                    <small class="text-muted d-block mt-2">Asociados al sistema inmobiliario</small>
                </div>
            </div>
        </div>

        <!-- Clients (Dynamic based on ShowActive) -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 admin-dashboard__card" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: var(--color-text-secondary); letter-spacing: 0.1em;">
                        @(Model.ShowActive ? "Clientes Activos" : "Clientes Inactivos")
                    </h5>
                    <h1 class="fw-bold m-0" style="color: var(--color-accent); font-size: 3rem;">
                        @(Model.ShowActive ? Model.ActiveClients : Model.InactiveClients)
                    </h1>
                    <small class="text-muted d-block mt-2">Buscando o comprando hogares</small>
                </div>
            </div>
        </div>

        <!-- Developers (Dynamic based on ShowActive) -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 admin-dashboard__card" style="border-radius: var(--radius-card); background: var(--color-surface);">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: var(--color-text-secondary); letter-spacing: 0.1em;">
                        @(Model.ShowActive ? "Desarrolladores Activos" : "Desarrolladores Inactivos")
                    </h5>
                    <h1 class="fw-bold m-0" style="color: var(--color-secondary); font-size: 3rem;">
                        @(Model.ShowActive ? Model.ActiveDevelopers : Model.InactiveDevelopers)
                    </h1>
                    <small class="text-muted d-block mt-2">Conectados a la API pública</small>
                </div>
            </div>
        </div>
    </div>
</div>
