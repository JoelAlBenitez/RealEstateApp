@using RealEstateApp.Core.Application.ViewsModel.Improvement
@model List<ImprovementViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mantenimiento de Mejoras";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--color-text);">Mantenimiento de Mejoras</h2>
            <p class="text-muted mb-0 small">Administra las características adicionales que los agentes pueden agregar a sus propiedades.</p>
        </div>
        <a asp-action="Create" class="rea-btn rea-btn--primary">Registrar Nueva Mejora</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5" style="background: var(--color-surface); border-radius: var(--radius-card);">
            <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 text-muted">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
            </svg>
            <h4 class="fw-bold" style="color: var(--color-text);">No hay mejoras registradas</h4>
            <p class="text-muted mb-4">Comienza registrando la primera mejora para que esté disponible al crear propiedades.</p>
            <a asp-action="Create" class="rea-btn rea-btn--primary">Registrar Mejora</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm" style="border-radius: var(--radius-card); background: var(--color-surface); overflow: hidden;">
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="color: var(--color-text);">
                    <thead style="background: var(--color-surface-variant); color: var(--color-text-secondary);">
                        <tr>
                            <th class="px-4 py-3 border-0" style="font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">Nombre</th>
                            <th class="px-4 py-3 border-0" style="font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">Descripción</th>
                            <th class="px-4 py-3 border-0 text-center" style="font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; width: 180px;">Propiedades</th>
                            <th class="px-4 py-3 border-0 text-end" style="font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="border-bottom: 1px solid var(--color-border);">
                                <td class="px-4 py-3 fw-semibold" style="font-size: 0.95rem;">@item.Name</td>
                                <td class="px-4 py-3 text-muted" style="font-size: 0.9rem; max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Description</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="badge rounded-pill px-3 py-2" style="background: rgba(13,110,253,0.1); color: var(--color-primary); font-size: 0.85rem; font-weight: 600;">
                                        @item.PropertyCount
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" 
                                           class="btn btn-sm d-inline-flex align-items-center justify-content-center" 
                                           style="background: rgba(13,110,253,0.1); color: var(--color-primary); border: 1px solid rgba(13,110,253,0.2); border-radius: 6px; padding: 6px 12px; font-weight: 500; font-size: 0.85rem;"
                                           title="Editar Mejora">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z" />
                                            </svg>
                                            Editar
                                        </a>
                                        <button type="button" 
                                                class="btn btn-sm d-inline-flex align-items-center justify-content-center btn-delete-trigger" 
                                                style="background: rgba(220,53,69,0.1); color: #dc3545; border: 1px solid rgba(220,53,69,0.2); border-radius: 6px; padding: 6px 12px; font-weight: 500; font-size: 0.85rem;"
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteModal" 
                                                data-id="@item.Id" 
                                                data-name="@item.Name"
                                                title="Eliminar Mejora">
                                            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                                <polyline points="3 6 5 6 21 6" />
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                            </svg>
                                            Eliminar
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal de Confirmación para Eliminar -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="background: var(--color-surface); border-radius: var(--radius-card);">
            <div class="modal-header border-0 px-4 pt-4 pb-0">
                <h5 class="modal-title fw-bold" id="deleteModalLabel" style="color: var(--color-text);">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3" style="color: var(--color-text);">
                <p class="mb-0">¿Estás seguro de que deseas eliminar la mejora "<strong id="deleteTargetName"></strong>"?</p>
                <div class="alert alert-warning border-0 shadow-sm mt-3 mb-0" style="border-radius: 8px; font-size: 0.85rem;">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-warning align-middle">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                    <strong>Nota:</strong> Se eliminará la mejora y sus relaciones con las propiedades asociadas, pero las propiedades en sí mismas permanecerán intactas.
                </div>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 d-flex gap-2">
                <button type="button" class="btn fw-semibold py-2 px-3 flex-fill" style="background: var(--color-surface-variant); color: var(--color-text); border-radius: 8px; border: 0;" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post" asp-action="Delete" class="flex-fill">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteTargetId" />
                    <button type="submit" class="btn fw-semibold py-2 px-3 w-100" style="background: #dc3545; color: white; border-radius: 8px; border: 0;">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteModal = document.getElementById('deleteModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const name = button.getAttribute('data-name');

                    const formIdInput = deleteModal.querySelector('#deleteTargetId');
                    const nameSpan = deleteModal.querySelector('#deleteTargetName');

                    formIdInput.value = id;
                    nameSpan.textContent = name;
                });
            }
        });
    </script>
}
