@using RealEstateApp.Core.Application.ViewsModel.MessageAtC
@model List<MessageAtCViewModel>
@{
    ViewData["Title"] = "Bandeja de Mensajes";
    var conversationMessages = ViewBag.ConversationMessages as List<MessageAtCViewModel>;
    var selectedAgentId = ViewBag.SelectedAgentId as string;
    var selectedPropertyId = ViewBag.SelectedPropertyId as int?;
    var hasConversation = conversationMessages != null && selectedAgentId != null;
    var chatPartnerName = conversationMessages?.FirstOrDefault()?.AgentName ?? "Agente Inmobiliario";
}

<style>
    .chat-layout {
        display: flex;
        height: calc(100vh - 120px);
        background: var(--color-surface);
        border-radius: var(--radius-card);
        border: 1px solid var(--color-border);
        overflow: hidden;
    }

    .chat-sidebar {
        width: 360px;
        min-width: 360px;
        border-right: 1px solid var(--color-border);
        display: flex;
        flex-direction: column;
        background: var(--color-surface);
    }

    .chat-sidebar-header {
        padding: 1.25rem;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface-variant);
    }

    .chat-sidebar-header h5 {
        color: var(--color-text);
        font-weight: 700;
        margin: 0;
    }

    .chat-contact-list {
        flex: 1;
        overflow-y: auto;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .chat-contact-item {
        display: flex;
        align-items: center;
        padding: 0.875rem 1.25rem;
        text-decoration: none;
        color: var(--color-text);
        border-bottom: 1px solid var(--color-border);
        transition: background 0.15s ease;
        cursor: pointer;
    }

    .chat-contact-item:hover {
        background: var(--color-surface-variant);
        color: var(--color-text);
    }

    .chat-contact-item.active {
        background: rgba(var(--color-primary-rgb, 13, 110, 253), 0.15);
        color: var(--color-text);
    }

    .chat-contact-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--color-primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-right: 0.875rem;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .chat-contact-info {
        flex: 1;
        min-width: 0;
    }

    .chat-contact-name {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 0.125rem;
        color: var(--color-text);
    }

    .chat-contact-preview {
        font-size: 0.83rem;
        color: var(--color-text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .chat-contact-meta {
        text-align: right;
        flex-shrink: 0;
        margin-left: 0.5rem;
    }

    .chat-contact-time {
        font-size: 0.72rem;
        color: var(--color-text-secondary);
        white-space: nowrap;
    }

    .chat-contact-property {
        font-size: 0.7rem;
        color: var(--color-text-secondary);
        margin-top: 0.125rem;
    }

    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: var(--color-background);
        min-width: 0;
    }

    .chat-main-header {
        padding: 0.875rem 1.25rem;
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface-variant);
        display: flex;
        align-items: center;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .chat-bubble {
        max-width: 70%;
        width: fit-content;
        min-width: 80px;
        padding: 0.625rem 0.875rem;
        word-break: break-word;
        white-space: pre-wrap;
        font-size: 0.92rem;
        line-height: 1.35;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .chat-bubble--received {
        align-self: flex-start;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 16px 16px 16px 4px;
        color: var(--color-text);
    }

    .chat-bubble--sent {
        align-self: flex-end;
        background: var(--color-primary);
        border-radius: 16px 16px 4px 16px;
        color: #fff;
    }

    .chat-bubble-time {
        font-size: 0.68rem;
        align-self: flex-end;
    }

    .chat-bubble--received .chat-bubble-time {
        color: var(--color-text-secondary);
    }

    .chat-bubble--sent .chat-bubble-time {
        opacity: 0.75;
    }

    .chat-input-area {
        padding: 0.875rem 1.25rem;
        border-top: 1px solid var(--color-border);
        background: var(--color-surface-variant);
    }

    .chat-placeholder {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--color-text-secondary);
    }

    .chat-placeholder svg {
        opacity: 0.3;
        margin-bottom: 1rem;
    }

    .chat-back-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: transparent;
        color: var(--color-text);
        margin-right: 0.625rem;
        cursor: pointer;
        flex-shrink: 0;
    }

    .chat-back-btn:hover {
        background: var(--color-surface);
    }

    .chat-empty-sidebar {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        text-align: center;
        color: var(--color-text-secondary);
    }

    @@media (max-width: 991.98px) {
        .chat-sidebar {
            width: 100%;
            min-width: 100%;
        }

        .chat-layout.conversation-active .chat-sidebar {
            display: none;
        }

        .chat-layout:not(.conversation-active) .chat-main {
            display: none;
        }

        .chat-layout.conversation-active .chat-back-btn {
            display: flex;
        }
    }
</style>

<div class="container-fluid py-3 px-lg-4">
    <div class="chat-layout @(hasConversation ? "conversation-active" : "")">
        <div class="chat-sidebar">
            <div class="chat-sidebar-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5>Mensajes</h5>
                    <span class="badge bg-primary">@Model.Count</span>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="chat-empty-sidebar">
                    <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    <p class="fw-semibold mb-1">No tienes mensajes</p>
                    <small>Inicia una conversación desde la ficha de una propiedad.</small>
                    <a asp-controller="Customer" asp-action="Index" class="rea-btn rea-btn--primary mt-3" style="font-size: 0.85rem;">Ver Propiedades</a>
                </div>
            }
            else
            {
                <ul class="chat-contact-list">
                    @foreach (var chat in Model)
                    {
                        var isActive = chat.AgentId == selectedAgentId && chat.PropertyId == selectedPropertyId;
                        <li>
                            <a asp-controller="Messages" asp-action="Index" asp-route-agentId="@chat.AgentId" asp-route-propertyId="@chat.PropertyId"
                               class="chat-contact-item @(isActive ? "active" : "")">
                                <div class="chat-contact-avatar">
                                    @(string.IsNullOrEmpty(chat.AgentName) ? "A" : chat.AgentName.Substring(0, 1).ToUpper())
                                </div>
                                <div class="chat-contact-info">
                                    <div class="chat-contact-name">@(chat.AgentName ?? "Agente")</div>
                                    <div class="chat-contact-preview">
                                        @if (chat.IsFromAgent)
                                        {
                                            <span>@(chat.AgentName?.Split(' ')[0] ?? "Agente"): </span>
                                        }
                                        else
                                        {
                                            <span>Tú: </span>
                                        }
                                        @chat.Content
                                    </div>
                                </div>
                                <div class="chat-contact-meta">
                                    <div class="chat-contact-time">@chat.CreateAt.ToLocalTime().ToString("dd/MM")</div>
                                    <div class="chat-contact-property">#@chat.PropertyCode</div>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="chat-main">
            @if (hasConversation)
            {
                <div class="chat-main-header">
                    <a asp-controller="Messages" asp-action="Index" class="chat-back-btn">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 12H5M12 19l-7-7 7-7"/>
                        </svg>
                    </a>
                    <div class="chat-contact-avatar" style="width: 40px; height: 40px; font-size: 0.95rem; margin-right: 0.75rem;">
                        @chatPartnerName?.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <div class="fw-bold" style="color: var(--color-text); font-size: 0.95rem;">@chatPartnerName</div>
                        <small style="color: var(--color-text-secondary); font-size: 0.8rem;">Propiedad #@selectedPropertyId</small>
                    </div>
                </div>

                <div class="chat-messages" id="chatContainer">
                    @if (conversationMessages == null || !conversationMessages.Any())
                    {
                        <div class="chat-placeholder">
                            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                            </svg>
                            <p class="fw-semibold m-0">No hay mensajes anteriores</p>
                            <small>Escribe tu primer mensaje abajo.</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in conversationMessages)
                        {
                            if (msg.IsFromAgent)
                            {
                                <div class="chat-bubble chat-bubble--received">
                                    <div>@msg.Content</div>
                                    <div class="chat-bubble-time">@msg.CreateAt.ToLocalTime().ToString("hh:mm tt")</div>
                                </div>
                            }
                            else
                            {
                                <div class="chat-bubble chat-bubble--sent">
                                    <div>@msg.Content</div>
                                    <div class="chat-bubble-time">@msg.CreateAt.ToLocalTime().ToString("hh:mm tt")</div>
                                </div>
                            }
                        }
                    }
                </div>

                <div class="chat-input-area">
                    <form asp-controller="Messages" asp-action="Send" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="PropertyId" value="@selectedPropertyId" />
                        <input type="hidden" name="AgentId" value="@selectedAgentId" />
                        <div class="input-group">
                            <input type="text" class="form-control" name="Content" placeholder="Escribe un mensaje..." required maxlength="500" autocomplete="off"
                                   style="border-radius: 8px 0 0 8px; background: var(--color-surface); border-color: var(--color-border); color: var(--color-text);" />
                            <button class="rea-btn rea-btn--primary" type="submit" style="border-radius: 0 8px 8px 0; margin-top: 0; padding-top: 0; padding-bottom: 0;">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="22" y1="2" x2="11" y2="13" />
                                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
            }
            else
            {
                <div class="chat-placeholder">
                    <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    <h5 class="fw-bold">Selecciona una conversación</h5>
                    <p style="font-size: 0.9rem;">Elige un chat de la lista para ver los mensajes.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var chatContainer = document.getElementById("chatContainer");
            if (chatContainer) {
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        });
    </script>
}
