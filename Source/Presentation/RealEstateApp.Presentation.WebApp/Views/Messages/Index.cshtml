@using RealEstateApp.Core.Application.ViewsModel.MessageAtC
@model List<MessageAtCViewModel>
@{
    ViewData["Title"] = "Bandeja de Mensajes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold mb-0" style="color: var(--color-text);">Bandeja de Entrada</h2>
        <span class="badge bg-primary">@Model.Count conversaciones</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5">
            <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 text-muted">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            <h4 class="fw-bold">No tienes mensajes todavía</h4>
            <p class="text-muted mb-4">Puedes iniciar una conversación con un agente inmobiliario desde la ficha de detalles de cualquier propiedad.</p>
            <a asp-controller="Customer" asp-action="Index" class="rea-btn rea-btn--primary">Ver Propiedades</a>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm" style="border-radius: var(--radius-card); overflow: hidden;">
            @foreach (var chat in Model)
            {
                <a asp-controller="Messages" asp-action="Conversation" asp-route-agentId="@chat.AgentId" asp-route-propertyId="@chat.PropertyId" class="list-group-item list-group-item-action p-4 border-0 border-bottom">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <div class="d-flex align-items-center">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px; color: var(--color-primary);">
                                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            </div>
                            <div>
                                <h5 class="mb-1 fw-bold">@chat.AgentName</h5>
                                <p class="mb-0 text-muted font-sm">Conversación sobre Propiedad #@chat.PropertyId</p>
                            </div>
                        </div>
                        <small class="text-muted">@chat.CreateAt.ToString("dd/MM/yyyy hh:mm tt")</small>
                    </div>
                    <div class="mt-3">
                        <p class="mb-0 text-secondary" style="font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            @if (chat.IsFromAgent)
                            {
                                <strong class="text-primary">Agente: </strong>
                            }
                            else
                            {
                                <strong>Tú: </strong>
                            }
                            @chat.Content
                        </p>
                    </div>
                </a>
            }
        </div>
    }
</div>
