@using RealEstateApp.Core.Application.ViewsModel.Users.Consult
@model AgentActionConfirmViewModel
@{
    Layout = "_AdminLayout";
    var deactivating = Model.IsActive;
    ViewData["Title"] = deactivating ? "Inactivar agente" : "Activar agente";
    var message = deactivating
        ? "¿Está seguro que desea inactivar este agente?"
        : "¿Está seguro que desea activar este agente?";
}

@section Styles {
    <link rel="stylesheet" href="~/css/AgentManagement/agent-management.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="agent-confirm @(deactivating ? "agent-confirm--warning" : "agent-confirm--success")">
        <span class="agent-confirm__icon" aria-hidden="true">
            @if (deactivating)
            {
                <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><path d="M22 4 12 14.01l-3-3" />
                </svg>
            }
        </span>

        <h2 class="agent-confirm__title">@message</h2>
        <p class="agent-confirm__subject">@Model.FullName</p>

        @if (deactivating)
        {
            <p class="agent-confirm__note">
                Un agente inactivo no podrá iniciar sesión, no aparecerá en el listado público y sus propiedades
                disponibles dejarán de mostrarse en las secciones públicas.
            </p>
        }

        <div class="agent-confirm__actions">
            <a asp-action="Index" class="rea-btn rea-btn--secondary">Cancelar</a>
            <form asp-action="ToggleStatus" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="active" value="@((!Model.IsActive).ToString().ToLowerInvariant())" />
                <button type="submit" class="rea-btn @(deactivating ? "rea-btn--danger" : "rea-btn--primary")">
                    @(deactivating ? "Inactivar" : "Activar")
                </button>
            </form>
        </div>
    </div>
</div>
