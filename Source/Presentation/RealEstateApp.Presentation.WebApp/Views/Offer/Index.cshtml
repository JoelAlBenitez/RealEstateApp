@using RealEstateApp.Core.Application.ViewsModel.Offer
@using RealEstateApp.Core.Domain.Common.Enums.OfferStatus
@model List<OfferViewModel>
@{
    ViewData["Title"] = "Mis Ofertas Adquiridas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold mb-0" style="color: var(--color-text);">Mis Ofertas Realizadas</h2>
        <span class="badge bg-primary">@Model.Count ofertas</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm text-center py-5">
            <svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 text-muted">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
            <h4 class="fw-bold">No has realizado ninguna oferta</h4>
            <p class="text-muted mb-4">Cuando encuentres una propiedad de tu interés, podrás enviarle ofertas al agente a cargo.</p>
            <a asp-controller="Customer" asp-action="Index" class="rea-btn rea-btn--primary">Ver Propiedades</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0" style="border-radius: var(--radius-card); background: var(--color-surface);">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr style="background: var(--color-surface-variant); border-bottom: 1px solid var(--color-border);">
                                <th class="ps-4 py-3" style="color: var(--color-text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Código de Propiedad</th>
                                <th class="py-3" style="color: var(--color-text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Monto Ofertado</th>
                                <th class="py-3" style="color: var(--color-text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Fecha Realizada</th>
                                <th class="py-3" style="color: var(--color-text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Estado</th>
                                <th class="pe-4 py-3 text-end" style="color: var(--color-text-secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var offer in Model)
                            {
                                <tr style="border-bottom: 1px solid var(--color-border);">
                                    <td class="ps-4">
                                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@offer.PropertyId" class="fw-bold text-decoration-none" style="color: var(--color-primary);">
                                            @offer.PropertyCode
                                        </a>
                                    </td>
                                    <td class="fw-bold text-success">@string.Format("{0:C}", offer.Amount)</td>
                                    <td>@offer.CreateAt.ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td>
                                        @if (offer.Status == OfferState.Pending)
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">Pendiente</span>
                                        }
                                        else if (offer.Status == OfferState.Accepted)
                                        {
                                            <span class="badge bg-success px-3 py-2">Aceptada</span>
                                        }
                                        else if (offer.Status == OfferState.Rejected)
                                        {
                                            <span class="badge bg-danger px-3 py-2">Rechazada</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (offer.Status == OfferState.Pending)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm px-3"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalCancelOffer"
                                                    data-offer-id="@offer.Id">
                                                Cancelar Oferta
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Cancelar Oferta -->
<div class="modal fade" id="modalCancelOffer" tabindex="-1" aria-labelledby="modalCancelOfferLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-card);">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#f59e0b" stroke-width="2">
                        <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    </svg>
                    <h5 class="modal-title fw-bold mb-0" id="modalCancelOfferLabel" style="color: var(--color-text);">Cancelar Oferta</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar" style="filter: invert(1);"></button>
            </div>
            <div class="modal-body pt-3" style="color: var(--color-text-secondary);">
                <p class="mb-0">¿Está seguro de que desea <strong style="color: var(--color-text);">cancelar</strong> esta oferta? Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>
                <form id="formCancelOffer" asp-controller="Offer" asp-action="Cancel" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="cancelOfferId" name="offerId" value="" />
                    <button type="submit" class="btn btn-danger fw-semibold px-4">Sí, Cancelar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('modalCancelOffer').addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        document.getElementById('cancelOfferId').value = btn.getAttribute('data-offer-id');
    });
</script>
}
