@model RealEstateApp.Core.Application.ViewsModel.Users.Operational.ExternalUser.ForgoutPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="account-shell">
    <div class="account-stage">
        <section class="account-panel">
            <div class="account-card">
                <div class="account-card__top">
                    <a class="account-back" asp-controller="Home" asp-action="Index" data-account-nav aria-label="Volver al inicio">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M19 12H5" />
                            <path d="m12 19-7-7 7-7" />
                        </svg>
                    </a>
                    <span class="account-brand">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 10.5 12 3l9 7.5" />
                            <path d="M5 9.5V21h14V9.5" />
                            <path d="M9.5 21v-6h5v6" />
                        </svg>
                        Real Estate App
                    </span>
                </div>

                <header class="account-card__head">
                    <h1 class="account-card__title">Recupera tu acceso</h1>
                    <p class="account-card__subtitle">Ingresa tu nombre de usuario y te enviaremos un enlace seguro para restablecer tu contraseña.</p>
                </header>

                <form class="account-form" asp-controller="Account" asp-action="ForgoutPassword" method="post" novalidate>
                    <div class="account-field">
                        <label class="account-field__label" asp-for="UserName">Nombre de usuario</label>
                        <div class="account-field__control">
                            <span class="account-field__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            </span>
                            <input class="account-input" asp-for="UserName" autocomplete="username" placeholder="Tu nombre de usuario" />
                        </div>
                        <span class="field-validation-error" asp-validation-for="UserName"></span>
                    </div>

                    <button class="account-btn account-btn--primary" type="submit">Enviar enlace de recuperación</button>
                </form>

                <div class="account-links">
                    <div class="account-links__row">
                        <span>¿Recordaste tu contraseña?</span>
                        <a class="account-link" asp-controller="Account" asp-action="Login" data-account-nav>Iniciar Sesión</a>
                    </div>
                    <div class="account-links__row">
                        <a class="account-link" asp-controller="Account" asp-action="RegisterExternalUser" data-account-nav>Registrarse</a>
                        <a class="account-link" asp-controller="Account" asp-action="ResendConfirmAccount" data-account-nav>Reenviar correo de confirmación</a>
                    </div>
                </div>
            </div>
        </section>

        <aside class="account-scene" aria-hidden="true">
            <div class="scene-headlines" data-scene-rotate>
                <p class="scene-headline is-active">Tu cuenta está protegida</p>
                <p class="scene-headline">Recuperación simple y segura</p>
                <p class="scene-headline">Estamos aquí para ayudarte</p>
            </div>
            <p class="scene-sub">Recibirás un correo con los pasos para volver a entrar en minutos.</p>

            <div class="scene-widget scene-widget--pos1">
                <span class="scene-widget__icon scene-widget__icon--success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Protección de cuenta</span>
                    <span class="scene-widget__hint">Tus datos siempre seguros</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos2">
                <span class="scene-widget__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-10 6L2 7" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Email enviado</span>
                    <span class="scene-widget__hint">Revisa tu bandeja de entrada</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos3">
                <span class="scene-widget__icon scene-widget__icon--secondary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Recuperación segura</span>
                    <span class="scene-widget__hint">Enlace de un solo uso</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos4">
                <span class="scene-widget__icon scene-widget__icon--accent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Listo en minutos</span>
                    <span class="scene-widget__hint">Sin complicaciones</span>
                </span>
            </div>

            <span class="scene-float scene-float--1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
            </span>
            <span class="scene-float scene-float--2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </span>
            <span class="scene-float scene-float--3">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m22 7-10 6L2 7" />
                </svg>
            </span>
            <span class="scene-float scene-float--4">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m21 2-9.6 9.6" />
                    <circle cx="7.5" cy="15.5" r="5.5" />
                    <path d="m21 2-1 1" />
                    <path d="m15.5 7.5 3 3L22 7l-3-3" />
                </svg>
            </span>
            <span class="scene-float scene-float--5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m8.5 12.5 2.5 2.5 5-6" />
                </svg>
            </span>
        </aside>
    </div>
</div>
