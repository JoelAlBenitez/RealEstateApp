@model RealEstateApp.Core.Application.ViewsModel.Users.Operational.ExternalUser.ResetPasswordViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="account-shell">
    <div class="account-stage">
        <section class="account-panel">
            <div class="account-card">
                <div class="account-card__top">
                    <a class="account-back" asp-controller="Home" asp-action="Index" data-account-nav aria-label="Volver al inicio">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M19 12H5" />
                            <path d="m12 19-7-7 7-7" />
                        </svg>
                    </a>
                    <span class="account-brand">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 10.5 12 3l9 7.5" />
                            <path d="M5 9.5V21h14V9.5" />
                            <path d="M9.5 21v-6h5v6" />
                        </svg>
                        Real Estate App
                    </span>
                </div>

                <header class="account-card__head">
                    <h1 class="account-card__title">Crea una nueva contraseña</h1>
                    <p class="account-card__subtitle">Elige una contraseña segura para volver a acceder a tu cuenta.</p>
                </header>

                <form class="account-form" asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Token" />

                    <div class="account-field">
                        <label class="account-field__label" asp-for="NewPassword">Nueva contraseña</label>
                        <div class="account-field__control">
                            <span class="account-field__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            </span>
                            <input class="account-input account-input--password" asp-for="NewPassword" autocomplete="new-password" placeholder="Mínimo 8 caracteres" />
                            <button class="account-pass-toggle" type="button" data-password-toggle="NewPassword" aria-label="Mostrar contraseña" aria-pressed="false">
                                <svg class="account-pass-toggle__icon account-pass-toggle__icon--show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="account-pass-toggle__icon account-pass-toggle__icon--hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </div>
                        <span class="field-validation-error" asp-validation-for="NewPassword"></span>
                    </div>

                    <div class="account-field">
                        <label class="account-field__label" asp-for="ConfirmNewPassword">Confirmación de contraseña</label>
                        <div class="account-field__control">
                            <span class="account-field__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            </span>
                            <input class="account-input account-input--password" asp-for="ConfirmNewPassword" autocomplete="new-password" placeholder="Repite tu nueva contraseña" />
                            <button class="account-pass-toggle" type="button" data-password-toggle="ConfirmNewPassword" aria-label="Mostrar contraseña" aria-pressed="false">
                                <svg class="account-pass-toggle__icon account-pass-toggle__icon--show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="account-pass-toggle__icon account-pass-toggle__icon--hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </div>
                        <span class="field-validation-error" asp-validation-for="ConfirmNewPassword"></span>
                    </div>

                    <button class="account-btn account-btn--primary" type="submit">Actualizar contraseña</button>
                </form>

                <div class="account-links">
                    <div class="account-links__row">
                        <span>¿Ya la recuerdas?</span>
                        <a class="account-link" asp-controller="Account" asp-action="Login" data-account-nav>Iniciar Sesión</a>
                    </div>
                </div>
            </div>
        </section>

        <aside class="account-scene" aria-hidden="true">
            <div class="scene-headlines" data-scene-rotate>
                <p class="scene-headline is-active">Acceso protegido</p>
                <p class="scene-headline">Tu seguridad es primero</p>
                <p class="scene-headline">Un paso más y estás dentro</p>
            </div>
            <p class="scene-sub">Al confirmar, tu contraseña quedará actualizada al instante.</p>

            <div class="scene-widget scene-widget--pos1">
                <span class="scene-widget__icon scene-widget__icon--success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        <path d="m9.5 16 2 2 3.5-4" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Contraseña actualizada</span>
                    <span class="scene-widget__hint">Cambio aplicado al instante</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos2">
                <span class="scene-widget__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="m9 12 2 2 4-4" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Cuenta protegida</span>
                    <span class="scene-widget__hint">Seguridad reforzada</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos3">
                <span class="scene-widget__icon scene-widget__icon--secondary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m21 2-9.6 9.6" />
                        <circle cx="7.5" cy="15.5" r="5.5" />
                        <path d="m21 2-1 1" />
                        <path d="m15.5 7.5 3 3L22 7l-3-3" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Acceso protegido</span>
                    <span class="scene-widget__hint">Solo tú tienes la llave</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos4">
                <span class="scene-widget__icon scene-widget__icon--accent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="m8.5 12.5 2.5 2.5 5-6" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Todo listo</span>
                    <span class="scene-widget__hint">Vuelve a iniciar sesión</span>
                </span>
            </div>

            <span class="scene-float scene-float--1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </span>
            <span class="scene-float scene-float--2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
            </span>
            <span class="scene-float scene-float--3">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m21 2-9.6 9.6" />
                    <circle cx="7.5" cy="15.5" r="5.5" />
                    <path d="m21 2-1 1" />
                    <path d="m15.5 7.5 3 3L22 7l-3-3" />
                </svg>
            </span>
            <span class="scene-float scene-float--4">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="m8.5 12.5 2.5 2.5 5-6" />
                </svg>
            </span>
            <span class="scene-float scene-float--5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 10.5 12 3l9 7.5" />
                    <path d="M5 9.5V21h14V9.5" />
                    <path d="M9.5 21v-6h5v6" />
                </svg>
            </span>
        </aside>
    </div>
</div>
