@model RealEstateApp.Core.Application.ViewsModel.Users.Auth.AccessDeniedViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Acceso denegado";
}

<div class="account-shell">
    <div class="account-stage">
        <section class="account-panel">
            <div class="account-card">
                <div class="account-card__top">
                    <a class="account-back" asp-controller="@Model.HomeController" asp-action="@Model.HomeAction" data-account-nav aria-label="Volver a mi inicio">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M19 12H5" />
                            <path d="m12 19-7-7 7-7" />
                        </svg>
                    </a>
                    <span class="account-brand">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 10.5 12 3l9 7.5" />
                            <path d="M5 9.5V21h14V9.5" />
                            <path d="M9.5 21v-6h5v6" />
                        </svg>
                        Real Estate App
                    </span>
                </div>

                <header class="account-card__head">
                    <h1 class="account-card__title">Acceso denegado</h1>
                    <p class="account-card__subtitle">No cuentas con los permisos necesarios para esta sección.</p>
                </header>

                <div class="account-message">
                    <span class="account-message__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                    </span>
                    <p class="account-message__text" role="alert">@Model.Message</p>
                    <div class="account-message__actions">
                        <a class="account-btn account-btn--primary" asp-controller="@Model.HomeController" asp-action="@Model.HomeAction" data-account-nav>Ir a mi inicio</a>
                    </div>
                </div>
            </div>
        </section>

        <aside class="account-scene" aria-hidden="true">
            <div class="scene-headlines" data-scene-rotate>
                <p class="scene-headline is-active">Tu sesión sigue activa</p>
                <p class="scene-headline">Vuelve a tu espacio</p>
                <p class="scene-headline">Explora lo que sí tienes disponible</p>
            </div>
            <p class="scene-sub">Esta sección está reservada para otro rol dentro de la plataforma.</p>

            <div class="scene-widget scene-widget--pos1">
                <span class="scene-widget__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Área protegida</span>
                    <span class="scene-widget__hint">Acceso restringido por rol</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos2">
                <span class="scene-widget__icon scene-widget__icon--success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Sesión activa</span>
                    <span class="scene-widget__hint">No necesitas volver a iniciar sesión</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos3">
                <span class="scene-widget__icon scene-widget__icon--accent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 10.5 12 3l9 7.5" />
                        <path d="M5 9.5V21h14V9.5" />
                        <path d="M9.5 21v-6h5v6" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Tu inicio te espera</span>
                    <span class="scene-widget__hint">Regresa con un solo clic</span>
                </span>
            </div>

            <span class="scene-float scene-float--1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </span>
            <span class="scene-float scene-float--2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 10.5 12 3l9 7.5" />
                    <path d="M5 9.5V21h14V9.5" />
                    <path d="M9.5 21v-6h5v6" />
                </svg>
            </span>
            <span class="scene-float scene-float--3">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
            </span>
        </aside>
    </div>
</div>
