@using RealEstateApp.Core.Domain.Common.Enums
@model RealEstateApp.Core.Application.ViewsModel.Users.Operational.ExternalUser.CreateExternalUserViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Crear cuenta";
}

<div class="account-shell">
    <div class="account-stage">
        <section class="account-panel">
            <div class="account-card">
                <div class="account-card__top">
                    <a class="account-back" asp-controller="Home" asp-action="Index" data-account-nav aria-label="Volver al inicio">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M19 12H5" />
                            <path d="m12 19-7-7 7-7" />
                        </svg>
                    </a>
                    <span class="account-brand">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 10.5 12 3l9 7.5" />
                            <path d="M5 9.5V21h14V9.5" />
                            <path d="M9.5 21v-6h5v6" />
                        </svg>
                        Real Estate App
                    </span>
                </div>

                <header class="account-card__head">
                    <h1 class="account-card__title">Crea tu cuenta</h1>
                    <p class="account-card__subtitle">Comienza una nueva experiencia como cliente o agente inmobiliario.</p>
                </header>

                <form class="account-form" id="registerForm" asp-controller="Account" asp-action="RegisterExternalUser" method="post" enctype="multipart/form-data" data-current-step="1" novalidate>
                    <div class="account-progress">
                        <span class="account-progress__label" data-step-label aria-live="polite">Paso 1 de 2</span>
                        <div class="account-progress__track" aria-hidden="true">
                            <div class="account-progress__fill"></div>
                        </div>
                    </div>

                    <div class="account-step is-active" data-step="1">
                        <div class="account-grid-2">
                            <div class="account-field">
                                <label class="account-field__label" asp-for="Name">Nombre</label>
                                <div class="account-field__control">
                                    <span class="account-field__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                            <circle cx="12" cy="7" r="4" />
                                        </svg>
                                    </span>
                                    <input class="account-input" asp-for="Name" autocomplete="given-name" placeholder="Tu nombre" />
                                </div>
                                <span class="field-validation-error" asp-validation-for="Name"></span>
                            </div>

                            <div class="account-field">
                                <label class="account-field__label" asp-for="LastName">Apellido</label>
                                <div class="account-field__control">
                                    <span class="account-field__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                            <circle cx="12" cy="7" r="4" />
                                        </svg>
                                    </span>
                                    <input class="account-input" asp-for="LastName" autocomplete="family-name" placeholder="Tu apellido" />
                                </div>
                                <span class="field-validation-error" asp-validation-for="LastName"></span>
                            </div>
                        </div>

                        <div class="account-field">
                            <label class="account-field__label" asp-for="Email">Correo electrónico</label>
                            <div class="account-field__control">
                                <span class="account-field__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="4" width="20" height="16" rx="2" />
                                        <path d="m22 7-10 6L2 7" />
                                    </svg>
                                </span>
                                <input class="account-input" asp-for="Email" autocomplete="email" placeholder="tucorreo@ejemplo.com" />
                            </div>
                            <span class="field-validation-error" asp-validation-for="Email"></span>
                        </div>

                        <div class="account-field">
                            <label class="account-field__label" asp-for="PhoneNumber">Número de teléfono</label>
                            <div class="account-field__control">
                                <span class="account-field__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                                    </svg>
                                </span>
                                <input class="account-input" asp-for="PhoneNumber" inputmode="tel" maxlength="10" autocomplete="tel-national" placeholder="8095551234" />
                            </div>
                            <span class="field-validation-error" asp-validation-for="PhoneNumber"></span>
                        </div>

                        <div class="account-step__actions">
                            <button class="account-btn account-btn--primary" type="button" data-step-next>
                                Continuar
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h14" />
                                    <path d="m12 5 7 7-7 7" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="account-step" data-step="2">
                        <div class="account-field">
                            <span class="account-field__label" id="typeUserLabel">Tipo de usuario</span>
                            <div class="account-roles" role="radiogroup" aria-labelledby="typeUserLabel">
                                <label class="account-role">
                                    <input class="account-role__input" type="radio" name="TypeUser" id="typeUserCliente" value="@((int)Roles.Cliente)" checked="@(Model.TypeUser != (int)Roles.Agente)" />
                                    <span class="account-role__body">
                                        <span class="account-role__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                                                <circle cx="12" cy="10" r="3" />
                                            </svg>
                                        </span>
                                        <span class="account-role__name">Cliente</span>
                                        <span class="account-role__hint">Busca y reserva tu próximo hogar.</span>
                                    </span>
                                </label>
                                <label class="account-role">
                                    <input class="account-role__input" type="radio" name="TypeUser" id="typeUserAgente" value="@((int)Roles.Agente)" checked="@(Model.TypeUser == (int)Roles.Agente)" />
                                    <span class="account-role__body">
                                        <span class="account-role__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 21h18" />
                                                <path d="M5 21V7l7-4 7 4v14" />
                                                <path d="M9 21v-4h6v4" />
                                                <path d="M10 10h.01M14 10h.01M10 14h.01M14 14h.01" />
                                            </svg>
                                        </span>
                                        <span class="account-role__name">Agente</span>
                                        <span class="account-role__hint">Publica propiedades y conecta con clientes.</span>
                                    </span>
                                </label>
                            </div>
                            <span class="field-validation-error" asp-validation-for="TypeUser"></span>
                        </div>

                        <div class="account-field">
                            <label class="account-field__label" asp-for="NameUser">Nombre de usuario</label>
                            <div class="account-field__control">
                                <span class="account-field__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10" />
                                        <circle cx="12" cy="10" r="3" />
                                        <path d="M6.17 18.85a6 6 0 0 1 11.66 0" />
                                    </svg>
                                </span>
                                <input class="account-input" asp-for="NameUser" autocomplete="username" placeholder="Elige un nombre de usuario" />
                            </div>
                            <span class="field-validation-error" asp-validation-for="NameUser"></span>
                        </div>

                        <div class="account-field">
                            <label class="account-field__label" asp-for="Password">Contraseña</label>
                            <div class="account-field__control">
                                <span class="account-field__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                </span>
                                <input class="account-input account-input--password" asp-for="Password" autocomplete="new-password" placeholder="Mín. 8 caracteres: mayúscula, minúscula, número y símbolo" />
                                <button class="account-pass-toggle" type="button" data-password-toggle="Password" aria-label="Mostrar contraseña" aria-pressed="false">
                                    <svg class="account-pass-toggle__icon account-pass-toggle__icon--show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg class="account-pass-toggle__icon account-pass-toggle__icon--hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                        <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                        <line x1="1" y1="1" x2="23" y2="23" />
                                    </svg>
                                </button>
                            </div>
                            <span class="field-validation-error" asp-validation-for="Password"></span>
                        </div>

                        <div class="account-field">
                            <label class="account-field__label" asp-for="ConfirmPassword">Confirmación de contraseña</label>
                            <div class="account-field__control">
                                <span class="account-field__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" />
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                    </svg>
                                </span>
                                <input class="account-input account-input--password" asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Repite tu contraseña" />
                                <button class="account-pass-toggle" type="button" data-password-toggle="ConfirmPassword" aria-label="Mostrar contraseña" aria-pressed="false">
                                    <svg class="account-pass-toggle__icon account-pass-toggle__icon--show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg class="account-pass-toggle__icon account-pass-toggle__icon--hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                        <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                        <line x1="1" y1="1" x2="23" y2="23" />
                                    </svg>
                                </button>
                            </div>
                            <span class="field-validation-error" asp-validation-for="ConfirmPassword"></span>
                        </div>

                        <div class="account-field">
                            <label class="account-field__label" asp-for="ProfileImg">Imagen de perfil</label>
                            <div class="account-file" data-file-field>
                                <input class="account-file__input" asp-for="ProfileImg" type="file" accept="image/*" />
                                <label class="account-file__label" asp-for="ProfileImg">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                        <polyline points="17 8 12 3 7 8" />
                                        <line x1="12" y1="3" x2="12" y2="15" />
                                    </svg>
                                    <span class="account-file__text" data-file-text>Selecciona tu imagen de perfil</span>
                                </label>
                                <img class="account-file__preview" data-file-preview alt="Vista previa de la imagen de perfil" hidden />
                            </div>
                            <span class="field-validation-error" asp-validation-for="ProfileImg"></span>
                        </div>

                        <div class="account-step__actions">
                            <button class="account-btn account-btn--ghost" type="button" data-step-prev>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M19 12H5" />
                                    <path d="m12 19-7-7 7-7" />
                                </svg>
                                Atrás
                            </button>
                            <button class="account-btn account-btn--primary" type="submit">Crear cuenta</button>
                        </div>
                    </div>
                </form>

                <div class="account-links">
                    <div class="account-links__row">
                        <span>¿Ya tienes una cuenta?</span>
                        <a class="account-link" asp-controller="Account" asp-action="Login" data-account-nav>Iniciar Sesión</a>
                    </div>
                </div>
            </div>
        </section>

        <aside class="account-scene" aria-hidden="true">
            <div class="scene-headlines" data-scene-rotate>
                <p class="scene-headline is-active">Comienza una nueva experiencia</p>
                <p class="scene-headline">Crea tu perfil en minutos</p>
                <p class="scene-headline">Publica tu primera propiedad</p>
                <p class="scene-headline">Encuentra tu primer hogar</p>
            </div>
            <p class="scene-sub">Únete a una comunidad que crece todos los días.</p>

            <div class="scene-widget scene-widget--pos1">
                <span class="scene-widget__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <line x1="19" y1="8" x2="19" y2="14" />
                        <line x1="16" y1="11" x2="22" y2="11" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Perfil creado</span>
                    <span class="scene-widget__hint">Bienvenido a la comunidad</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos2">
                <span class="scene-widget__icon scene-widget__icon--success">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 7 13.5 15.5 8.5 10.5 2 17" />
                        <path d="M16 7h6v6" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Nueva propiedad publicada</span>
                    <span class="scene-widget__hint">Tu negocio sigue creciendo</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos3">
                <span class="scene-widget__icon scene-widget__icon--secondary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">Agentes conectados</span>
                    <span class="scene-widget__hint">Clientes buscando propiedades</span>
                </span>
            </div>

            <div class="scene-widget scene-widget--pos4">
                <span class="scene-widget__icon scene-widget__icon--accent">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="m8.5 12.5 2.5 2.5 5-6" />
                    </svg>
                </span>
                <span class="scene-widget__body">
                    <span class="scene-widget__title">98% de satisfacción</span>
                    <span class="scene-widget__hint">Miles de historias felices</span>
                </span>
            </div>

            <span class="scene-float scene-float--1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 10.5 12 3l9 7.5" />
                    <path d="M5 9.5V21h14V9.5" />
                    <path d="M9.5 21v-6h5v6" />
                </svg>
            </span>
            <span class="scene-float scene-float--2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 7 13.5 15.5 8.5 10.5 2 17" />
                    <path d="M16 7h6v6" />
                </svg>
            </span>
            <span class="scene-float scene-float--3">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z" />
                </svg>
            </span>
            <span class="scene-float scene-float--4">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                </svg>
            </span>
            <span class="scene-float scene-float--5">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                </svg>
            </span>
        </aside>
    </div>
</div>
